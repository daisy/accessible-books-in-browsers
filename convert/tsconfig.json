{
    "compilerOptions": {
        "baseUrl": "src",
        "rootDir": "./src",
        "outDir": "./build",
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "node",
        "types": [
            "node",
            "jsdom"
        ],
        "allowSyntheticDefaultImports": true,
        "alwaysStrict": true,
        "strict": true,
        "sourceMap": true,
        "esModuleInterop": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
